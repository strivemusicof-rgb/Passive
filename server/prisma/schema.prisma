generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Server-side game balance values (prices, income rates, fees...).
/// Changing a row here rebalances the game without a new iOS build.
model EconomyConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("economy_config")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  /// Shown on leaderboards. Unique, case-insensitive via displayNameKey.
  displayName  String    @map("display_name")
  displayNameKey String  @unique @map("display_name_key")
  /// Apple's stable user id ("sub" claim).
  appleSub     String?   @unique @map("apple_sub")
  email        String?   @unique
  passwordHash String?   @map("password_hash")
  isGuest      Boolean   @default(false) @map("is_guest")
  language     String    @default("lv")
  level        Int       @default(1)
  xp           Int       @default(0)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at")
  /// The one free plot every player gets.
  starterClaimed Boolean @default(false) @map("starter_claimed")
  sessions     Session[]
  wallet       Wallet?
  transactions Transaction[]
  plots        Plot[]

  @@map("users")
}

/// One logged-in device. Holds a hash of the refresh token (never the token).
model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")

  @@index([userId])
  @@map("sessions")
}

model Wallet {
  userId    String   @id @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Never negative: enforced by a CHECK constraint in the migration.
  coins     Int      @default(0)
  gems      Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("wallets")
}

enum Currency {
  coins
  gems
}

/// Ledger: one row for every change to a wallet. The balance must always
/// equal the sum of a player's rows.
model Transaction {
  id           BigInt   @id @default(autoincrement())
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency     Currency
  /// Positive = received, negative = spent.
  amount       Int
  balanceAfter Int      @map("balance_after")
  /// e.g. welcome_bonus, plot_purchase
  type         String
  /// What the change was for, e.g. the plot "row_col".
  ref          String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("transactions")
}

/// Only bought plots are stored; every other grid cell is free.
model Plot {
  row           Int
  col           Int
  /// Public number shown as "#8472", assigned on first purchase.
  number        Int      @unique @default(autoincrement())
  ownerId       String   @map("owner_id") @db.Uuid
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Fixed when first bought, so later hotspot changes don't affect it.
  rarity        String
  buildingLevel Int      @default(0) @map("building_level")
  name          String?
  acquiredAt    DateTime @default(now()) @map("acquired_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@id([row, col])
  @@index([ownerId])
  @@map("plots")
}
