generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Server-side game balance values (prices, income rates, fees...).
/// Changing a row here rebalances the game without a new iOS build.
model EconomyConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("economy_config")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  /// Shown on leaderboards. Unique, case-insensitive via displayNameKey.
  displayName  String    @map("display_name")
  displayNameKey String  @unique @map("display_name_key")
  /// Apple's stable user id ("sub" claim).
  appleSub     String?   @unique @map("apple_sub")
  email        String?   @unique
  passwordHash String?   @map("password_hash")
  isGuest      Boolean   @default(false) @map("is_guest")
  language     String    @default("lv")
  level        Int       @default(1)
  xp           Int       @default(0)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at")
  /// The one free plot every player gets.
  starterClaimed Boolean @default(false) @map("starter_claimed")
  /// Index into economy storageHours (how long plots keep earning before Collect).
  storageLevel Int       @default(0) @map("storage_level")
  /// Day of the 7-day login streak claimed most recently (1–7; 0 = never).
  streakDay    Int       @default(0) @map("streak_day")
  /// Riga calendar day (YYYY-MM-DD) of the last daily-reward claim.
  lastDailyClaim String? @map("last_daily_claim")
  /// Equipped cosmetics (item ids from shared/src/cosmetics.js)
  nameColor    String?   @map("name_color")
  avatarFrame  String?   @map("avatar_frame")
  cosmetics    UserCosmetic[]
  sessions     Session[]
  wallet       Wallet?
  transactions Transaction[]
  plots        Plot[]
  missions     MissionProgress[]
  checkIns     CheckIn[]
  cashouts     CashoutRequest[]
  adViews      AdView[]
  sales        Listing[] @relation("sales")
  purchases    Listing[] @relation("purchases")
  favourites   Favourite[]

  @@map("users")
}

/// One logged-in device. Holds a hash of the refresh token (never the token).
model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")

  @@index([userId])
  @@map("sessions")
}

model Wallet {
  userId    String   @id @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Never negative: enforced by a CHECK constraint in the migration.
  coins     Int      @default(0)
  gems      Int      @default(0)
  /// Reward points: earned only by free activity, never bought or traded; the only cash-out currency.
  points    Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("wallets")
}

enum Currency {
  coins
  gems
  points
}

/// Ledger: one row for every change to a wallet. The balance must always
/// equal the sum of a player's rows.
model Transaction {
  id           BigInt   @id @default(autoincrement())
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency     Currency
  /// Positive = received, negative = spent.
  amount       Int
  balanceAfter Int      @map("balance_after")
  /// e.g. welcome_bonus, plot_purchase
  type         String
  /// What the change was for, e.g. the plot "row_col".
  ref          String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("transactions")
}

/// Only bought plots are stored; every other grid cell is free.
model Plot {
  row           Int
  col           Int
  /// Public number shown as "#8472", assigned on first purchase.
  number        Int      @unique @default(autoincrement())
  ownerId       String   @map("owner_id") @db.Uuid
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Fixed when first bought, so later hotspot changes don't affect it.
  rarity        String
  buildingLevel Int      @default(0) @map("building_level")
  name          String?
  /// Cosmetics shown on the map (item ids); cleared when the plot is sold.
  skin          String?
  flag          String?
  /// Income accrues from here (capped by the owner's storage); reset on collect.
  collectedAt   DateTime @default(now()) @map("collected_at")
  acquiredAt    DateTime @default(now()) @map("acquired_at")
  createdAt     DateTime @default(now()) @map("created_at")
  listings      Listing[]

  @@id([row, col])
  @@index([ownerId])
  @@map("plots")
}

/// Progress on one mission in one period ("d:2026-10-04" or "w:2026-W40").
model MissionProgress {
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  period    String
  key       String
  progress  Int       @default(0)
  claimedAt DateTime? @map("claimed_at")

  @@id([userId, period, key])
  @@map("mission_progress")
}

/// A player standing at their own plot (once per plot per Riga day).
model CheckIn {
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  row       Int
  col       Int
  day       String
  reward    Int
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, row, col, day])
  @@index([userId, day])
  @@map("check_ins")
}

enum CashoutStatus {
  pending
  approved
  paid
  rejected
}

/// A player asking to turn reward points into money. Points are held when
/// the request is made and given back if it's rejected.
model CashoutRequest {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  points      Int
  eurCents    Int           @map("eur_cents")
  /// "paypal" or a gift card type
  method      String
  /// PayPal email (or where to send the gift card)
  destination String
  status      CashoutStatus @default(pending)
  /// Reason shown to the player when rejected
  note        String?
  createdAt   DateTime      @default(now()) @map("created_at")
  decidedAt   DateTime?     @map("decided_at")

  @@index([status, createdAt])
  @@index([userId])
  @@map("cashout_requests")
}

/// One rewarded video ad. Created when the app is about to show an ad; the
/// reward is paid once, when Google confirms the ad was watched (server-side
/// verification) or, while that's off, when the app reports it.
model AdView {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "collect2x" or "bonus"
  placement     String
  /// collect2x: the collect ledger row being doubled (one ad per collect)
  ref           String?
  /// Coins this ad pays (fixed when it starts)
  coins         Int       @default(0)
  /// Points actually given (after limits)
  points        Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at")
  rewardedAt    DateTime? @map("rewarded_at")
  /// AdMob's transaction id: stops the same callback paying twice
  admobTxId     String?   @unique @map("admob_tx_id")

  @@unique([placement, ref])
  @@index([userId, createdAt])
  @@map("ad_views")
}

enum ListingStatus {
  active
  sold
  cancelled
}

/// A plot for sale on the marketplace. At most one active listing per plot
/// (partial unique index in the migration).
model Listing {
  id        String        @id @default(uuid()) @db.Uuid
  row       Int
  col       Int
  plot      Plot          @relation(fields: [row, col], references: [row, col], onDelete: Cascade)
  sellerId  String        @map("seller_id") @db.Uuid
  seller    User          @relation("sales", fields: [sellerId], references: [id], onDelete: Cascade)
  price     Int
  /// Coins the market kept (set when sold)
  fee       Int           @default(0)
  status    ListingStatus @default(active)
  buyerId   String?       @map("buyer_id") @db.Uuid
  buyer     User?         @relation("purchases", fields: [buyerId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now()) @map("created_at")
  closedAt  DateTime?     @map("closed_at")

  @@index([status, createdAt])
  @@index([sellerId])
  @@index([buyerId, closedAt])
  @@index([row, col])
  @@map("listings")
}

/// A plot the player marked with a heart.
model Favourite {
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  row       Int
  col       Int
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, row, col])
  @@map("favourites")
}

/// Gems paid to the month's top players (rank 0 with no user = "month done,
/// nobody qualified"). The primary key makes paying a month twice impossible.
model LeaderboardPrize {
  month     String
  rank      Int
  userId    String?  @map("user_id") @db.Uuid
  gems      Int      @default(0)
  score     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([month, rank])
  @@map("leaderboard_prizes")
}

/// A cosmetic item the player owns (bought once, used as often as they like).
model UserCosmetic {
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String   @map("item_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, itemId])
  @@map("user_cosmetics")
}
