{
  "expo": {
    "name": "LANDRUSH",
    "slug": "landrush",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "landrush",
    "userInterfaceStyle": "dark",
